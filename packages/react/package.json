{
  "name": "@pplancq/shelter-ui-react",
  "version": "1.0.0-alpha.7",
  "license": "MIT",
  "description": "Modular, scalable React components",
  "author": "pplancq <paul.plancq@outlook.fr>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pplancq/shelter-ui",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/pplancq/shelter-ui/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://pplancq.github.io/shelter-ui/",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "concurrently --prefix-colors auto \"npm:eslint\" \"npm:tsc\"",
    "eslint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postversion": "npm i --save-peer @pplancq/shelter-ui-icon@$npm_package_version"
  },
  "engines": {
    "node": ">= 22"
  },
  "peerDependencies": {
    "@pplancq/shelter-ui-icon": "^1.0.0-alpha.7",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@pplancq/svg-react": "^3.0.12"
  },
  "devDependencies": {
    "@pplancq/eslint-config": "^6.1.0",
    "@pplancq/prettier-config": "^4.0.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "prettier": "@pplancq/prettier-config",
  "lint-staged": {
    "*.(js|jsx|ts|tsx)": "eslint --fix",
    "*.{ts,tsx}": "tsc-files --noEmit",
    "*": "prettier --write --ignore-unknown"
  }
}
